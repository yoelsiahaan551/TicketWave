# Flask
FLASK_ENV=development
SECRET_KEY=

# Database
# Kosongin dulu -> otomatis pakai SQLite lokal (instance/dev.db)
# Diisi kalau udah connect ke Supabase, contoh:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# JWT (nyusul pas bagian auth)
JWT_SECRET_KEY=

# Cloudinary (isi dari dashboard cloudinary.com -> Account Details)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Midtrans (nyusul pas bagian payment)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=False
